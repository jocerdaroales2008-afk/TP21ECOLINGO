# Google Maps API Key (requiere Maps JavaScript API, Places API, y Directions API habilitadas)
VITE_GOOGLE_API_KEY=your_google_api_key_here

# Supabase (Opcional, si usas autenticación o base de datos)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
